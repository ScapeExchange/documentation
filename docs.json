{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "SCAPE",
  "description": "Documentation for SHCU, the Shanghai copper perpetual and outcome markets on Hyperliquid.",
  "colors": {
    "primary": "#00AB9B",
    "light": "#40D1BF",
    "dark": "#00796A"
  },
  "favicon": "/logo/scape-icon.png",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "fonts": {
    "heading": {
      "family": "Raleway",
      "weight": 600
    },
    "body": {
      "family": "Raleway",
      "weight": 400
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant",
      "mcp",
      "add-mcp"
    ]
  },
  "navigation": {
    "directory": "card",
    "groups": [
      {
        "group": "Overview",
        "icon": "book-open",
        "expanded": true,
        "pages": [
          "introduction",
          "getting-started",
          "architecture",
          "benchmark"
        ]
      },
      {
        "group": "SHCU perpetual",
        "icon": "activity",
        "expanded": true,
        "pages": [
          "contract-specification",
          "oracle",
          "mark-price",
          "funding",
          "margin-and-liquidation",
          "open-interest-caps",
          "fees",
          "trading-calendar"
        ]
      },
      {
        "group": "Outcome markets",
        "icon": "target",
        "expanded": true,
        "pages": [
          "outcome-markets",
          "outcome-liquidity"
        ]
      },
      {
        "group": "Liquidity",
        "icon": "droplet",
        "expanded": true,
        "pages": [
          "liquidity-program",
          "index-behavior-and-hedging"
        ]
      },
      {
        "group": "Developers",
        "icon": "code",
        "expanded": true,
        "pages": [
          "api-integration"
        ]
      },
      {
        "group": "Reference",
        "icon": "library",
        "expanded": true,
        "pages": [
          "operations-and-change-control",
          "changelog",
          "risk-disclosures",
          "faq",
          "glossary"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/scape-icon.png",
    "dark": "/logo/scape-icon.png"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Main Page",
      "href": "https://scape.exchange"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/yourcompany",
      "linkedin": "https://linkedin.com/company/yourcompany"
    },
    "links": [
      {
        "header": "Scape",
        "items": [
          {
            "label": "Website",
            "href": "https://scape.exchange"
          },
          {
            "label": "Risk disclosures",
            "href": "/risk-disclosures"
          },
          {
            "label": "Changelog",
            "href": "/changelog"
          }
        ]
      }
    ]
  },
  "banner": {
    "content": "Preview build for internal review. Not for distribution.",
    "dismissible": true
  },
  "redirects": [
    {
      "source": "/market-mechanics/overview",
      "destination": "/architecture"
    },
    {
      "source": "/market-mechanics/oracle-price",
      "destination": "/oracle"
    },
    {
      "source": "/market-mechanics/mark-price",
      "destination": "/mark-price"
    },
    {
      "source": "/market-mechanics/external-price",
      "destination": "/oracle"
    },
    {
      "source": "/market-mechanics/funding",
      "destination": "/funding"
    },
    {
      "source": "/market-mechanics/fees",
      "destination": "/fees"
    },
    {
      "source": "/assets/commodities",
      "destination": "/contract-specification"
    },
    {
      "source": "/assets/fx",
      "destination": "/contract-specification"
    },
    {
      "source": "/risk-and-margining/margin-modes",
      "destination": "/margin-and-liquidation"
    },
    {
      "source": "/risk-and-margining/liquidation-mechanics",
      "destination": "/margin-and-liquidation"
    },
    {
      "source": "/risk-and-margining/auto-deleveraging",
      "destination": "/margin-and-liquidation"
    }
  ]
}
